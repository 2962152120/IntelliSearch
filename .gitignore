# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/

# ---- 测试 / 覆盖率 ----
.pytest_cache/
# pytest --basetemp: 刻意放在项目内而非 %TEMP%。
# 环境的删除保护钩子会拦截 Temp\pytest-of-ASUS 下的批量清理并超时,
# 导致进程在打印测试摘要之前被中断(表现为"跑完了但看不到 passed 行数")
.pytest-tmp/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.hypothesis/

# ---- 类型检查 / lint ----
.mypy_cache/
.ruff_cache/
.dmypy.json

# ---- 密钥与本地配置 ----
# .env.example 是模板(仅占位符)需要提交; 真实 .env 绝不能进仓库
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.yaml
secrets.yml

# ---- 运行时产物 ----
*.sqlite3
*.sqlite
*.db
*.log
*.pid
.cache/
intellisearch_cache/

# ---- 本机/AI 工具工作目录 ----
