# IntelliSearch 环境变量示例（复制为 .env 或直接在环境中设置）

# ---------- 检索源 ----------
# 可用: bing_rss, bing_html, sogou, so360, tavily, serpapi, brave
# 后三者需要 API Key，配置了会自动启用
IS_PROVIDERS=bing_rss,bing_html,sogou,so360

# ---------- 网络 ----------
IS_TIMEOUT=15                # 单请求超时（秒）
IS_CONNECT_TIMEOUT=5
IS_RETRIES=2                 # 失败退避重试次数
IS_MAX_CONCURRENCY=8         # 全局并发上限
IS_PER_HOST_CONCURRENCY=2    # 单主机并发上限
IS_VERIFY_SSL=true
IS_ROTATE_UA=true            # UA 轮换
IS_PROXIES=                  # 代理池，逗号分隔：http://u:p@1.2.3.4:8080,socks5://5.6.7.8:1080

# ---------- 缓存 ----------
IS_CACHE=true
IS_CACHE_TTL=1800            # 检索结果缓存秒数
IS_CACHE_PATH=~/.intellisearch/cache.sqlite3
IS_CACHE_MAX_ENTRIES=5000

# ---------- 限流 ----------
IS_RATE_LIMIT=true
IS_GLOBAL_QPS=5
IS_GLOBAL_BURST=10
IS_SESSION_QPS=1
IS_SESSION_BURST=3

# ---------- 抓取 ----------
IS_FETCH_MAX_BYTES=3000000
IS_FETCH_MEDIA=false         # 默认不下载图片/视频/字体/CSS
IS_RESPECT_ROBOTS=true       # 遵守 robots.txt

# ---------- 浏览器渲染(内置 Chromium, 无需任何第三方 API Key) ----------
# 渲染只在"轻量 HTTP 拿不到实质内容"时才真正启动浏览器, 静态页零额外开销;
# 找不到可用内核时自动退回纯 HTTP, 不会因此报错。
IS_RENDER=true               # 总开关, false=彻底禁用渲染
IS_RENDER_HEADLESS=true      # false=有头模式(本地调试看渲染过程)
IS_RENDER_TIMEOUT=25         # 单页渲染总超时(秒)
IS_RENDER_WAIT_UNTIL=domcontentloaded   # load | domcontentloaded | networkidle
IS_RENDER_SETTLE_MS=0        # 加载完成后的额外静默等待(毫秒), SPA 慢渲染可调 800~1500
IS_RENDER_WAIT_SELECTOR=     # 等待某元素出现, 如 "#content"(留空则不等待)
IS_RENDER_SCROLL=false       # 滚动到底触发懒加载
IS_RENDER_BLOCK_RES=true     # 拦截图片/视频/字体, 只加载渲染文本所需资源
IS_RENDER_MAX_PAGES=4        # 并发页签上限(浏览器池信号量)
IS_BROWSER_PATH=             # 手动指定内核, 如 C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
                            # 留空则自动发现: 系统 Chrome/Edge/Chromium/Brave
                            #   → ms-playwright 缓存(任意版本) → playwright bundled
IS_CHROME_PATH=              # 旧字段名, 等价于 IS_BROWSER_PATH(兼容保留)

# ---------- 排序权重 ----------
IS_W_RELEVANCE=1.0
IS_W_FRESHNESS=0.35
IS_W_CREDIBILITY=0.3
IS_W_LENGTH=0.08

# ---------- 安全与日志 ----------
IS_BLACKLIST=                # 敏感词，逗号分隔
IS_BLOCK_SUSPICIOUS=true
IS_LOG_LEVEL=INFO
IS_AUDIT_LOG=true
IS_AUDIT_PATH=~/.intellisearch/audit.log

# ---------- 商业检索源（可选） ----------
TAVILY_API_KEY=
SERPAPI_API_KEY=
BRAVE_API_KEY=
